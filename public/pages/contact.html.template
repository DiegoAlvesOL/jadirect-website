<!-- Contact, formulário único via Web3Forms, absorve conteúdo do Quote -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Talk to Us – JADirect Logistics</title>
    <meta name="description" content="Get in touch with the JADirect team for a delivery, a collection or a quote. Based in Dublin, serving all of Ireland.">

    <link rel="icon" type="image/png" sizes="32x32" href="../assets/images/favicons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="../assets/images/favicons/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="../assets/images/favicons/apple-touch-icon.png">
    <link rel="manifest" href="../site.webmanifest">
    <link rel="icon" href="../favicon.ico" sizes="any">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="JADirect Logistics">
    <meta property="og:title" content="Talk to Us – JADirect Logistics">
    <meta property="og:description" content="Get in touch with the JADirect team for a delivery, a collection or a quote. Based in Dublin, serving all of Ireland.">
    <meta property="og:url" content="https://jadirect.ie/pages/contact.html">
    <meta property="og:image" content="https://jadirect.ie/assets/images/hero-delivery.webp">
    <link rel="canonical" href="https://jadirect.ie/pages/contact.html">


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="../assets/css/globals.css">
    <link rel="stylesheet" href="../assets/css/layout.css">
    <link rel="stylesheet" href="../assets/css/pages/contact.css">
</head>
<body>
<header>
    <nav class="navbar">
        <div class="container">
             <a href="../index.html" class="navbar-logo">
                <img src="../assets/images/logo-white.webp" alt="JADirect Logo" class="logo-img" width="192" height="80">
             </a>
             <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Open menu">
                <span class="nav-toggle-icon"></span>
             </button>
                <ul class="nav-links" id="primary-nav">
                <li><a href="../index.html#services">Services</a></li>
                <li><a href="about.html">About</a></li>
                <li><a href="fleet.html">Fleet</a></li>
                <li><a href="contact.html">Contact</a></li>
            </ul>
        </div>
    </nav>
</header>

<main>
    <section class="contact-hero">
        <div class="contact-hero-image"></div>
        <div class="hero-overlay"></div>
        <div class="contact-hero-content">
            <a href="../index.html" class="page-back-link">← Back to Home</a>
            <h1>Talk to Us</h1>
            <p class="contact-hero-sub">Whether it's a delivery, a collection or a quote, our team is ready to help.</p>
        </div>
    </section>

    <section class="how-it-works reveal">
        <div class="container">
            <h2>How It Works</h2>
            <ol class="steps-list">
                <li><strong>Fill in the form.</strong> Tell us what you need, a general question or a quote request.</li>
                <li><strong>We review your request.</strong> A member of our team checks the details personally.</li>
                <li><strong>We follow up.</strong> Our team gets in touch with you for the next steps.</li>
            </ol>
        </div>
    </section>

    <section class="contact-concierge reveal">
        <div class="container">
            <div class="concierge-content">
                <h2 class="contact-info-title">Concierge Service</h2>
                <p class="contact-info-text">Whether you have a question about a delivery, need help planning a route or simply want to talk through your logistics needs, our team is here.</p>

                <div class="contact-detail">
                    <svg viewBox="0 0 24 24">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                        <polyline points="22,6 12,13 2,6"/>
                    </svg>
                    <a href="mailto:support@jadirect.ie">support@jadirect.ie</a>
                </div>

                <div class="contact-detail">
                    <svg viewBox="0 0 24 24">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                    <a href="tel:+35310000000">+353 1 000 0000</a>
                </div>

                <div class="contact-detail">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                    <span>Monday to Friday, 8am – 6pm</span>
                </div>
            </div>
        </div>
    </section>

    <section class="contact-form-section reveal">
        <div class="container">
            <form
                class="form-card"
                id="contact-form"
                action="https://api.web3forms.com/submit"
                method="POST"
            >
                <h2>Send Us a Message</h2>

                <input type="hidden" name="access_key" value="${WEB3FORMS_ACCESS_KEY}">
                <input type="hidden" name="redirect" value="${WEB3FORMS_REDIRECT_URL}">
                <input type="hidden" name="subject" id="form-subject">

                <div class="form-group">
                    <label for="enquiry-type">What can we help with?</label>
                    <select id="enquiry-type" name="enquiryType">
                        <option value="general" selected>General Enquiry</option>
                        <option value="quote">Request a Quote</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="contact-name">Full Name</label>
                    <input type="text" id="contact-name" name="fullName" required>
                </div>

                <div class="form-group">
                    <label for="contact-email">Email Address</label>
                    <input type="email" id="contact-email" name="email" required>
                </div>

                <div class="form-group">
                    <label for="contact-phone">Phone Number</label>
                    <input type="tel" id="contact-phone" name="phone">
                </div>

                <div class="form-group">
                    <label for="contact-message">Message</label>
                    <textarea id="contact-message" name="message" placeholder="How can we help you?" required></textarea>
                </div>

                <button type="submit" class="btn-primary full-width">Send Message</button>
            </form>
        </div>
    </section>

    <section class="trust-cards reveal">
        <div class="container">
            <div class="advantages-list">
                <div class="advantage-item">
                    <span class="advantage-dot"></span>
                    <div>
                        <h3>No Commitment Required</h3>
                        <p>Get in touch with no obligation to proceed.</p>
                    </div>
                </div>
                <div class="advantage-item">
                    <span class="advantage-dot"></span>
                    <div>
                        <h3>Direct Support</h3>
                        <p>Our team reviews every request personally.</p>
                    </div>
                </div>
                <div class="advantage-item">
                    <span class="advantage-dot"></span>
                    <div>
                        <h3>Tailored to Your Needs</h3>
                        <p>We work with your actual route, volume and requirements.</p>
                    </div>
                </div>
                <div class="advantage-item">
                    <span class="advantage-dot"></span>
                    <div>
                        <h3>Ireland-Wide Coverage</h3>
                        <p>We collect and deliver anywhere in Ireland, any county.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<footer class="footer">
    <div class="container">
        <div class="footer-bottom">
            <ul class="footer-legal">
                <li><a href="legal.html#privacy">Privacy</a></li>
                <li><a href="legal.html#terms">Terms of Use</a></li>
                <li><a href="legal.html#legal-notice">Legal Notice</a></li>
                <li><a href="legal.html#cookies" id="cookie-settings-link">Cookie Settings</a></li>
            </ul>
            <div class="footer-copy">2026 © JADirect Logistics – All rights reserved</div>
        </div>
    </div>
</footer>


<!-- SCRIPTS -->
<script type="module" src="../assets/js/main.js"></script>
<script type="module" src="../assets/js/view-transitions.js"></script>
<script type="module" src="../assets/js/cookie-consent.js"></script>
<script type="module" src="../assets/js/nav-menu.js"></script>
</body>
</html>